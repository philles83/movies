{
  "name": "tizenbrew-streaming-browser",
  "version": "0.1.2",
  "description": "Konfigurierbarer Website-Browser mit gezielten DOM-Filtern und TV-Fokusnavigation",
  "appName": "Streaming Browser",
  "packageType": "mods",
  "websiteURL": "https://google.com/",
  "main": "main.js",
  "evaluateScriptOnDocumentStart": false,
  "keys": [],
  "scripts": {
    "build": "node scripts/build.js",
    "check": "node scripts/build.js --check",
    "test": "node --test tests/build.test.js && node tests/browser.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:serve": "node tests/server.cjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "private": true
}
